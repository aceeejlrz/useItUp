<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_reminders">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_notifications"
            app:key="reminders_enabled"
            app:summary="@string/pref_daily_summary"
            app:title="@string/pref_daily_title"
            app:widgetLayout="@layout/pref_material_switch" />

        <!-- Also used for the Pantry colours, so it stays enabled when reminders are off. -->
        <ListPreference
            app:defaultValue="3"
            app:entries="@array/alert_window_entries"
            app:entryValues="@array/alert_window_values"
            app:icon="@drawable/ic_calendar"
            app:key="alert_days"
            app:title="@string/pref_window_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:dependency="reminders_enabled"
            app:icon="@drawable/ic_schedule"
            app:key="reminder_hour"
            app:persistent="false"
            app:title="@string/pref_time_title" />

        <com.team15.useitup.ui.settings.PermissionPreference
            app:icon="@drawable/ic_notifications_off"
            app:key="notification_permission"
            app:title="@string/pref_permission_title" />

        <Preference
            app:icon="@drawable/ic_play_circle"
            app:key="test_reminder"
            app:persistent="false"
            app:summary="@string/pref_test_summary"
            app:title="@string/pref_test_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_about">

        <Preference
            app:icon="@drawable/ic_about_app"
            app:key="about_version"
            app:persistent="false"
            app:selectable="false"
            app:summary="@string/about_version_summary"
            app:title="UseItUp" />

        <Preference
            app:icon="@drawable/ic_group"
            app:persistent="false"
            app:selectable="false"
            app:summary="@string/about_team_summary"
            app:title="@string/about_team_title" />

        <Preference
            app:icon="@drawable/ic_menu_book"
            app:persistent="false"
            app:selectable="false"
            app:summary="@string/about_sources_summary"
            app:title="@string/about_sources_title" />
    </PreferenceCategory>
</PreferenceScreen>
