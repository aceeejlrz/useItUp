<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.UseItUp.Card"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status edge; the colour always comes with the text badge. -->
        <View
            android:id="@+id/edge"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            tools:background="@color/status_soon_edge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Chicken breast" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="500 g · Meat &amp; Fish" />
        </LinearLayout>

        <TextView
            android:id="@+id/badge"
            style="@style/Widget.UseItUp.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            tools:backgroundTint="@color/status_soon_bg"
            tools:text="2 days left"
            tools:textColor="@color/status_soon_fg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/find_recipes"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:icon="@drawable/ic_restaurant"
            app:iconTint="?attr/colorPrimary"
            app:strokeColor="?attr/colorOutlineVariant"
            tools:contentDescription="Find recipes with Chicken breast" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
